// Writes the recipe photo maps from the catalogue (K-30). Metro bundles every
// photo a require() can reach, so the maps are generated with one static
// require() per photo, split in two:
//
//   src/data/catalogue/images.ts       photos of recipes that ship in store builds
//   src/data/catalogue/draftImages.ts  photos only drafts use, required by images.ts
//                                      behind the same build check as the drafts
//                                      themselves, so a store build leaves them out
//
// Photos are WebP at assets/recipes/<file>.webp (1200 x 900, quality 80). A
// recipe's file is its image key, unless scripts/data/shared-photos.json says
// its photo is the same file as another recipe's.
//
// Run by convert-old-recipes.mts after it writes the catalogue, or on its own
// (no old app needed): npm run catalogue:photos. Exits non-zero when a photo is
// missing or a file in assets/recipes isn't used by any recipe.

import { existsSync, readdirSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

import { shipsInStoreBuilds } from '../src/domain/recipes/provenance.ts';
import type { Recipe } from '../src/domain/recipes/types.ts';

export const PHOTO_DIR = 'assets/recipes';
export const PHOTO_EXT = '.webp';

type SharedPhotos = { shared: Record<string, string> };

function sharedPhotos(root: string): Record<string, string> {
  return (JSON.parse(readFileSync(join(root, 'scripts/data/shared-photos.json'), 'utf8')) as SharedPhotos).shared;
}

// Quoted only where needed, as Prettier writes it, so a rebuild matches the committed file.
const prop = (id: string) => (/^[a-z_$][\w$]*$/i.test(id) ? id : `'${id}'`);
const line = (id: string, file: string) => `  ${prop(id)}: require('../../../${PHOTO_DIR}/${file}${PHOTO_EXT}'),`;

/** Writes images.ts and draftImages.ts; returns any problems found. */
export function writeRecipePhotoMaps(root: string, recipes: readonly Recipe[]): string[] {
  const shared = sharedPhotos(root);
  const problems: string[] = [];
  const withPhoto = recipes.flatMap((r) =>
    r.image ? [{ id: r.id, file: shared[r.id] ?? r.image.key, ships: shipsInStoreBuilds(r.provenance) }] : [],
  );

  const used = new Set(withPhoto.map((p) => p.file));
  for (const file of used) {
    if (!existsSync(join(root, PHOTO_DIR, `${file}${PHOTO_EXT}`))) problems.push(`no photo at ${PHOTO_DIR}/${file}${PHOTO_EXT}`);
  }
  for (const name of readdirSync(join(root, PHOTO_DIR))) {
    if (!name.endsWith(PHOTO_EXT) || !used.has(name.slice(0, -PHOTO_EXT.length))) {
      problems.push(`${PHOTO_DIR}/${name} isn't any recipe's photo`);
    }
  }
  for (const id of Object.keys(shared)) {
    if (!withPhoto.some((p) => p.id === id)) problems.push(`shared-photos.json lists ${id}, which has no photo`);
  }

  const header = '// Generated by scripts/recipe-photos.mts (npm run catalogue:photos). Do not edit by hand.';
  writeFileSync(
    join(root, 'src/data/catalogue/draftImages.ts'),
    [
      header,
      '// Photos only draft recipes use. images.ts requires this file in development and',
      '// preview builds only, so a store build never bundles them (K-30).',
      'export const DRAFT_IMAGES: Readonly<Record<string, number>> = {',
      ...withPhoto.filter((p) => !p.ships).map((p) => line(p.id, p.file)),
      '};',
      '',
    ].join('\n'),
  );
  writeFileSync(
    join(root, 'src/data/catalogue/images.ts'),
    [
      header,
      '// Recipe id to bundled photo. Drafts show only in development and preview builds',
      '// (catalogue.ts). A store build has __DEV__ false and the variable unset, both',
      '// fixed at build time, so Metro drops the require() below and the drafts’ photos',
      '// stay out of it (K-30). Changing the variable locally needs `expo start --clear`.',
      'export const RECIPE_IMAGES: Readonly<Record<string, number>> = {',
      ...withPhoto.filter((p) => p.ships).map((p) => line(p.id, p.file)),
      "  ...(__DEV__ || process.env.EXPO_PUBLIC_SHOW_DRAFT_RECIPES === '1'",
      '    ? // A conditional require() is what lets Metro leave the file out; an import would always bundle it.',
      '      // eslint-disable-next-line @typescript-eslint/no-require-imports',
      "      (require('./draftImages') as typeof import('./draftImages')).DRAFT_IMAGES",
      '    : {}),',
      '};',
      '',
    ].join('\n'),
  );
  return problems;
}

if (process.argv[1] === fileURLToPath(import.meta.url)) {
  const root = join(dirname(fileURLToPath(import.meta.url)), '..');
  const recipes = JSON.parse(readFileSync(join(root, 'src/data/catalogue/recipes.json'), 'utf8')) as Recipe[];
  const problems = writeRecipePhotoMaps(root, recipes);
  for (const p of problems) console.error(p);
  console.log(`Wrote the photo maps for ${recipes.filter((r) => r.image).length} recipes; ${problems.length} problem(s).`);
  if (problems.length) process.exit(1);
}
