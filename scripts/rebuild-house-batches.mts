// Rebuilds the house-batch part of the catalogue without the old app (batch 03).
// The full converter (convert-old-recipes.mts) needs the old app's source to
// redo the converted recipes; this keeps those exactly as they are in
// recipes.json and re-appends every batch in scripts/data/house-recipes/, then
// regenerates images.ts the same way the converter does.
//
//   npx tsx scripts/rebuild-house-batches.mts
//
// Exits non-zero, writing nothing, if any batch has a problem.

import { readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

import { buildIngredientIndex, type IngredientDef } from '../src/domain/ingredients/database.ts';
import type { Recipe } from '../src/domain/recipes/types.ts';
import { batchFiles, loadHouseRecipes, readBatch } from './house-recipes.mts';

const root = join(dirname(fileURLToPath(import.meta.url)), '..');
const cataloguePath = join(root, 'src/data/catalogue/recipes.json');
const defs = JSON.parse(readFileSync(join(root, 'src/data/ingredients/ingredients.json'), 'utf8')) as IngredientDef[];
const index = buildIngredientIndex(defs);

const houseIds = new Set(batchFiles(root).flatMap((f) => readBatch(f).recipes.map((r) => r.id)));
const converted = (JSON.parse(readFileSync(cataloguePath, 'utf8')) as Recipe[]).filter((r) => !houseIds.has(r.id));
const taken = { ids: new Set(converted.map((r) => r.id)), titles: new Set(converted.map((r) => r.title.toLowerCase())) };

const problems: string[] = [];
const recipes = [...converted, ...loadHouseRecipes(root, index, taken, (m) => problems.push(m))];
if (problems.length) {
  for (const p of problems) console.error(`  ✗ ${p}`);
  process.exit(1);
}

writeFileSync(cataloguePath, `${JSON.stringify(recipes, null, 2)}\n`);
// As in convert-old-recipes.mts: Metro needs a static require() per image.
const withImages = recipes.flatMap((r) => (r.image ? [{ id: r.id, key: r.image.key }] : []));
writeFileSync(
  join(root, 'src/data/catalogue/images.ts'),
  [
    '// Generated by scripts/convert-old-recipes.mts. Do not edit by hand.',
    'export const RECIPE_IMAGES: Readonly<Record<string, number>> = {',
    ...withImages.map(({ id, key }) => `  ${/^[a-z_$][\w$]*$/i.test(id) ? id : `'${id}'`}: require('../../../assets/recipes/${key}.jpg'),`),
    '};',
    '',
  ].join('\n'),
);
console.log(
  `Catalogue: ${recipes.length} recipes (${converted.length} converted, ${recipes.length - converted.length} from house batches); ${withImages.length} with photos.`,
);
