// "I put 72 things in my pantry and it says I can cook 4": before and after
// the ingredient model, for a realistic 72-item test pantry
// (scripts/data/test-pantry-72.txt) against the catalogue and the published
// recipes (read only). Writes docs/reports/pantry-match.md.
// Run: npx tsx scripts/pantry-match-report.mts [--refresh]
import { readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

import { readPantryList } from '../src/domain/cupboard/addList.ts';
import { cookable, needLine, tierOf, type Shelf } from '../src/domain/cupboard/cookable.ts';
import { buildKitchen, type Kitchen, type KitchenData } from '../src/domain/cupboard/kitchen.ts';
import { buildIngredientIndex, type IngredientDef, type IngredientIndex } from '../src/domain/ingredients/database.ts';
import { withAliases, type HierarchyData } from '../src/domain/ingredients/hierarchy.ts';
import { parseIngredientGroups } from '../src/domain/published/published.ts';
import type { IngredientGroupBlock, Recipe } from '../src/domain/recipes/types.ts';
import { loadSnapshot } from './published-snapshot.mts';

const root = join(dirname(fileURLToPath(import.meta.url)), '..');
const read = <T,>(p: string) => JSON.parse(readFileSync(join(root, p), 'utf8')) as T;
const defs = read<IngredientDef[]>('src/data/ingredients/ingredients.json');
const kitchenData = read<KitchenData>('src/data/ingredients/kitchen.json');
const hierarchy = read<HierarchyData>('src/data/ingredients/hierarchy.json');
const catalogue = read<Recipe[]>('src/data/catalogue/recipes.json');
const pantryText = readFileSync(join(root, 'scripts/data/test-pantry-72.txt'), 'utf8');

type Setup = { label: string; index: IngredientIndex; kitchen: Kitchen };
const oldIndex = buildIngredientIndex(defs);
const newIndex = buildIngredientIndex(withAliases(defs, hierarchy));
const before: Setup = { label: 'Before', index: oldIndex, kitchen: buildKitchen(oldIndex, kitchenData) };
const after: Setup = { label: 'After', index: newIndex, kitchen: buildKitchen(newIndex, kitchenData, hierarchy) };

const snap = await loadSnapshot();
type Dish = { id: string; title: string; groups: IngredientGroupBlock[] };
const sets: { name: string; dishes: Dish[] }[] = [
  {
    name: 'Catalogue, store build (reviewed)',
    dishes: catalogue.filter((r) => r.provenance !== 'ai-draft').map((r) => ({ id: r.id, title: r.title, groups: r.ingredientGroups })),
  },
  { name: 'Catalogue, dev build (drafts too)', dishes: catalogue.map((r) => ({ id: r.id, title: r.title, groups: r.ingredientGroups })) },
  {
    name: `Published by the AI cooks (${snap.recipes.length})`,
    dishes: snap.recipes.map((r) => ({ id: r.id, title: r.title, groups: parseIngredientGroups(r.groups) })),
  },
];
const shelves: { name: string; shelf: Shelf }[] = [
  { name: 'shelf assumed (default)', shelf: { mode: 'assume', ids: [] } },
  { name: 'only what I ticked', shelf: { mode: 'mine', ids: [] } },
];

function run(setup: Setup, shelf: Shelf, dishes: Dish[]) {
  const have = new Set(readPantryList(pantryText, setup.index).flatMap((g) => (g.id ? [g.id] : [])));
  let ready = 0;
  let nearly = 0;
  const examples: string[] = [];
  for (const d of dishes) {
    const c = cookable({ ingredientGroups: d.groups }, have, shelf, setup.index, setup.kitchen);
    const tier = tierOf(c);
    if (tier === 'ready') ready++;
    if (tier === 'nearly') {
      nearly++;
      if (examples.length < 6)
        examples.push(`${d.title}: ${needLine(c, (id) => setup.index.byId.get(id)?.name ?? id.replace(/^unknown:/, ''))}`);
    }
  }
  return { ready, nearly, have: have.size, examples };
}

const lines: string[] = [
  '# Pantry match: before and after the ingredient model',
  '',
  `Generated by \`npx tsx scripts/pantry-match-report.mts\` on ${new Date().toISOString().slice(0, 10)}. Test pantry: \`scripts/data/test-pantry-72.txt\` (72 everyday items, typed the way a cook would).`,
  '',
  '"Can cook now" = nothing missing (shelf items assumed where noted). "Missing 1-2" = one or two things short.',
  '',
  '| Recipes | Shelf | Before: can cook now | Before: missing 1-2 | After: can cook now | After: missing 1-2 |',
  '|---|---|---|---|---|---|',
];
const examples: string[] = [];
for (const set of sets) {
  for (const s of shelves) {
    const b = run(before, s.shelf, set.dishes);
    const a = run(after, s.shelf, set.dishes);
    lines.push(`| ${set.name} | ${s.name} | ${b.ready} | ${b.nearly} | ${a.ready} | ${a.nearly} |`);
    if (s.shelf.mode === 'assume') examples.push(`**${set.name}**`, '', ...a.examples.map((e) => `- ${e}`), '');
  }
}
const subsOn = run(after, { mode: 'assume', ids: [], substitutes: true }, sets[2]!.dishes);
const oilOff = run(after, { mode: 'assume', ids: [], oil: false }, sets[2]!.dishes);
lines.push(
  '',
  `With substitutes counted (published recipes, shelf assumed): ${subsOn.ready} can cook now, ${subsOn.nearly} missing 1-2.`,
  `With the oil switch off (published recipes, shelf assumed): ${oilOff.ready} can cook now, ${oilOff.nearly} missing 1-2.`,
  '',
  '## Examples from "Missing 1-2" (after)',
  '',
  ...examples,
);
writeFileSync(join(root, 'docs/reports/pantry-match.md'), `${lines.join('\n')}\n`);
console.log(lines.slice(6, 14).join('\n'));
console.log(lines.slice(14, 17).join('\n'));
